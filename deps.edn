{:deps {org.babashka/http-client {:mvn/version "0.4.25"}
        babashka/fs {:mvn/version "0.5.34"}
        babashka/process {:mvn/version "0.6.25"}
        rewrite-clj/rewrite-clj {:mvn/version "1.3.59"}
        borkdude/rewrite-edn {:mvn/version "0.6.10"}
        org.babashka/cli {:mvn/version "0.12.91"}
        cheshire/cheshire {:mvn/version "6.2.0"}
        io.github.seancorfield/deps-new {:git/url "https://github.com/seancorfield/deps-new"
                                         :git/tag "v0.17.0-rc1"
                                         :git/sha "3f502e7"}
        version-clj/version-clj {:mvn/version "2.0.3"}}
 :tools/usage {:ns-default babashka.neil.api}
 :aliases
 {:neil
  {:project {:version "0.3.70"}}

  :test ;; added by neil
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/url "https://github.com/cognitect-labs/test-runner"
                 :git/tag "v0.5.1"
                 :git/sha "dfb30dd"}}
   :main-opts ["-m" "cognitect.test-runner"]
   :exec-fn cognitect.test-runner.api/test}

  :dev
  {:extra-paths ["test"]
   :extra-deps {io.github.cognitect-labs/test-runner
                {:git/url "https://github.com/cognitect-labs/test-runner"
                 :git/tag "v0.5.1"
                 :git/sha "dfb30dd"}
                io.github.tonsky/clj-reload {:mvn/version "1.0.0"}}}
  }}
